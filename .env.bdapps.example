# ==============================================
# BDApps API Configuration Guide
# ==============================================
# 
# Get your credentials from: https://developer.bdapps.com
# After creating an account and registering your application
#
# IMPORTANT: In production, set BDAPPS_USE_PLATFORM_OTP=true
# This enables OTP via BDApps platform instead of local SMS
# ==============================================

# Base URL for BDApps API (usually don't change this)
BDAPPS_BASE_URL=https://developer.bdapps.com

# Your Application ID from BDApps Developer Portal
# Example: APP_012345
BDAPPS_APP_ID=your_app_id_here

# Your Application Password from BDApps Developer Portal  
# This is usually an MD5-like hash provided by BDApps
BDAPPS_PASSWORD=your_password_here

# Enable Platform OTP (recommended for production)
# true = Use BDApps OTP service
# false = Use local OTP generation (development only)
BDAPPS_USE_PLATFORM_OTP=true

# Enable Platform Subscription Management
# true = Use BDApps subscription APIs
# false = Manual subscription management
BDAPPS_USE_PLATFORM_SUBSCRIPTION=true

# API Timeout in seconds (increase if slow network)
BDAPPS_TIMEOUT=30

# Optional: Custom SMS URL if you have dedicated endpoint
# BDAPPS_SMS_URL=

# Optional: Custom USSD URL
# BDAPPS_USSD_URL=

# Optional: Source Address for SMS (your short code)
# BDAPPS_SOURCE_ADDRESS=

# Optional: Enable OTP debug mode (shows OTP in logs - dev only!)
# BDAPPS_OTP_DEBUG=false

# ==============================================
# Testing Your Configuration
# ==============================================
# 
# 1. Copy this file to .env and fill in your credentials:
#    cp .env.bdapps.example .env
#
# 2. Test OTP request with a Bangladesh phone number:
#    Format: 8801XXXXXXXXX (with country code, no +)
#
# 3. Check logs if errors occur:
#    tail -f storage/logs/laravel.log
#
# 4. Common error codes:
#    - E1312: Invalid request (check payload format)
#    - E1601: Network/connection error
#    - E1XXX: Authentication error (wrong APP_ID or PASSWORD)
#    - S1000: Success!
#
# ==============================================
